 {
  "id": "lithology-mix",
  "title": "Mostly shale, and a long tail",
  "takeaway": "Shale makes up 62% of all samples and appears in 108 of the 108 wells. 6 of the 12 lithology classes are under 1% of the samples each.",
  "sql": "SET http_retries = 8;   -- one file per well: ride out Hugging Face rate limits\nSET VARIABLE wells = (\n    SELECT list('https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/force_2020/wells/' || path)\n    FROM read_json('https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/force_2020/wells/_files.json') AS manifest(path)\n);\n\nSELECT CASE FORCE_2020_LITHOFACIES_LITHOLOGY\n           WHEN 30000 THEN 'Sandstone'\n           WHEN 65000 THEN 'Shale'\n           WHEN 65030 THEN 'Sandstone/Shale'\n           WHEN 70000 THEN 'Limestone'\n           WHEN 70032 THEN 'Chalk'\n           WHEN 74000 THEN 'Dolomite'\n           WHEN 80000 THEN 'Marl'\n           WHEN 86000 THEN 'Anhydrite'\n           WHEN 88000 THEN 'Halite'\n           WHEN 90000 THEN 'Coal'\n           WHEN 93000 THEN 'Basement'\n           WHEN 99000 THEN 'Tuff'\n       END AS lithology,\n       count(*) * 100 / sum(count(*)) OVER () AS percent_of_samples,\n       count(DISTINCT WELL) AS wells,\n       len(getvariable('wells')) AS wells_in_corpus   -- one file per well\nFROM read_parquet(getvariable('wells'))\nGROUP BY lithology\nORDER BY percent_of_samples DESC;",
