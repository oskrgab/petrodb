  "polars": "import polars as pl\n\ndaily = pl.scan_parquet(\"https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/volve/daily_production.parquet\")\nwells = pl.scan_parquet(\"https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/volve/wells.parquet\")\n\nby_well = (\n    daily.join(wells, on=\"npd_wellbore_code\")\n    .group_by(pl.col(\"wellbore_name\").alias(\"well\"))\n    .agg(\n        (pl.col(\"oil_volume\").sum() / 1e6).alias(\"oil_million_sm3\"),\n        (pl.col(\"water_injection_volume\").sum() / 1e6).alias(\"water_injected_million_sm3\"),\n    )\n    .sort(\"oil_million_sm3\", descending=True)\n    .collect()\n)"
 }
