  "polars": "import polars as pl\n\nurl = \"https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/volve/daily_production.parquet\"\n\nmonthly = (\n    pl.scan_parquet(url)\n    .group_by(pl.col(\"date\").dt.truncate(\"1mo\").alias(\"month\"))\n    .agg(\n        pl.col(\"oil_volume\").sum().alias(\"oil_sm3\"),\n        pl.col(\"gas_volume\").sum().alias(\"gas_sm3\"),\n        pl.col(\"water_volume\").sum().alias(\"water_sm3\"),\n    )\n    .sort(\"month\")\n    .collect()\n)"
 },
 {
  "id": "cumulative-oil",
  "title": "Most of the oil came from two wells",
  "takeaway": "15/9-F-12 and 15/9-F-14 produced 85% of the field's 10.0 million Sm³ of oil. 15/9-F-4 produced none and injected 16.2 million Sm³ of water to hold up reservoir pressure.",
  "sql": "SELECT w.wellbore_name AS well,\n       coalesce(sum(d.oil_volume), 0) / 1e6             AS oil_million_sm3,\n       coalesce(sum(d.water_injection_volume), 0) / 1e6 AS water_injected_million_sm3\nFROM 'https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/volve/daily_production.parquet' AS d\nJOIN 'https://huggingface.co/datasets/oskrgab/petrodb/resolve/main/volve/wells.parquet' AS w USING (npd_wellbore_code)\nGROUP BY well\nORDER BY oil_million_sm3 DESC;",
